{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "text",
          "status",
          "evidence_type",
          "sources"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pending",
              "supported",
              "partially_supported",
              "contradicted",
              "not_found",
              "insufficient_access",
              "not_assessable"
            ]
          },
          "evidence_type": {
            "enum": [
              "unassessed",
              "direct",
              "extrapolation",
              "counterevidence",
              "mixed"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "locator"
              ],
              "anyOf": [
                {
                  "required": [
                    "path"
                  ]
                },
                {
                  "required": [
                    "url"
                  ]
                }
              ],
              "properties": {
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "excerpt": {
                  "type": "string"
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "semantic_review": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    }
  }
}
