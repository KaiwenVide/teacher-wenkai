{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wenkai experimental analysis configuration",
  "type": "object",
  "required": [
    "study",
    "input",
    "comparisons"
  ],
  "properties": {
    "study": {
      "type": "object",
      "required": [
        "design",
        "data_scale"
      ],
      "properties": {
        "design": {
          "enum": [
            "independent",
            "paired",
            "longitudinal"
          ]
        },
        "data_scale": {
          "enum": [
            "linear",
            "log2",
            "ct",
            "raw_counts"
          ]
        },
        "independent_units_confirmed": {
          "type": "boolean"
        },
        "sample_is_biological_unit": {
          "type": "boolean"
        },
        "taxon_id": {
          "type": "integer",
          "minimum": 1
        },
        "organism": {
          "type": "string"
        },
        "time_unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input": {
      "type": "object",
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "type": "string",
          "minLength": 1
        },
        "layout": {
          "enum": [
            "long",
            "wide"
          ]
        },
        "header_row": {
          "type": "integer",
          "minimum": 1
        },
        "sample_header_row": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "test",
          "reference"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "test": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "properties": {
        "technical_aggregation": {
          "enum": [
            "none",
            "mean",
            "median",
            "sum"
          ]
        },
        "test": {
          "enum": [
            "welch",
            "paired_t",
            "mannwhitney",
            "wilcoxon",
            "ols"
          ]
        },
        "transform": {
          "enum": [
            "none",
            "log2"
          ]
        },
        "alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "min_n": {
          "type": "integer",
          "minimum": 2
        },
        "minimum_effect": {
          "type": "number",
          "minimum": 0
        },
        "min_detection": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fdr_family": {
          "enum": [
            "all",
            "per_contrast"
          ]
        },
        "adjust_batch": {
          "type": "boolean"
        }
      }
    },
    "research": {
      "type": "object",
      "properties": {
        "public_context": {
          "type": "string"
        },
        "max_signals": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "max_queries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "papers_per_query": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    }
  }
}
