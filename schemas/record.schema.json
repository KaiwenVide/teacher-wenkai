{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "record_id",
    "title",
    "identifiers",
    "authors",
    "provenance"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "year": {
      "type": [
        "integer",
        "null"
      ]
    },
    "identifiers": {
      "type": "object"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "oa_locations": {
      "type": "array"
    }
  }
}
